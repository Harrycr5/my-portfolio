---
import type { PortfolioCopy } from "../../i18n/es";

interface Props {
  copy: Pick<PortfolioCopy,
    | "experienceEyebrow"
    | "experienceTitle"
    | "experiencePeriod"
    | "experienceSummary"
    | "experiencePoints"
  >;
}

const { copy } = Astro.props;
---

<section class="section-shell section-block" id="experience" aria-labelledby="experience-title">
  <div class="experience-heading">
    <p class="eyebrow">{copy.experienceEyebrow}</p>
    <article class="experience-card">
      <div class="experience-meta">
        <h2 id="experience-title">{copy.experienceTitle}</h2>
        <p class="experience-period">{copy.experiencePeriod}</p>
      </div>
      <div class="experience-details">
        <p>{copy.experienceSummary}</p>
        <ul>
          {copy.experiencePoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    </article>
  </div>
</section>

<style>
  .experience-heading {
    margin-bottom: 1.3rem;
  }

  .experience-card {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 7vw, 6rem);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: rgba(25, 22, 35, 0.7);
  }

  .experience-meta h2 {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
  }

  .experience-period {
    display: inline-flex;
    margin: 1rem 0 0;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(255, 186, 82, 0.27);
    border-radius: 99px;
    color: var(--accent-bright);
    font-size: 0.73rem;
  }

  .experience-details {
    color: #c1bbc9;
    font-size: 0.9rem;
  }

  .experience-details > p {
    margin-bottom: 1.1rem;
  }

  .experience-details ul {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience-details li {
    position: relative;
    padding-left: 1rem;
  }

  .experience-details li::before {
    position: absolute;
    top: 0.67em;
    left: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
    content: "";
  }

  @media (max-width: 620px) {
    .experience-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
