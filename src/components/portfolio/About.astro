---
import type { PortfolioCopy } from "../../i18n/es";

interface Props {
  copy: Pick<PortfolioCopy,
    | "aboutEyebrow"
    | "aboutTitle"
    | "aboutText"
    | "aboutDetail"
  >;
}

const { copy } = Astro.props;
---

<section class="about section-shell section-block" id="about" aria-labelledby="about-title">
  <div>
    <p class="eyebrow">{copy.aboutEyebrow}</p>
    <h2 id="about-title">{copy.aboutTitle}</h2>
  </div>
  <div class="about-copy">
    <p>{copy.aboutText}</p>
    <p>{copy.aboutDetail}</p>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 8vw, 7rem);
    align-items: start;
  }

  .about-copy {
    padding-top: 0.3rem;
    color: #c1bbc9;
  }

  .about-copy p {
    margin-bottom: 1rem;
  }

  .about-copy p:last-child {
    margin-bottom: 0;
    color: var(--muted);
  }

  @media (max-width: 620px) {
    .about {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
