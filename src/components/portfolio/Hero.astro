---
import type { PortfolioCopy } from "../../i18n/es";

interface Props {
  copy: Pick<PortfolioCopy,
    | "eyebrow"
    | "greeting"
    | "name"
    | "intro"
    | "viewProjects"
    | "contactMe"
    | "available"
    | "profileLabel"
    | "portraitAlt"
    | "profileNote"
  >;
  base: string;
}

const { copy, base } = Astro.props;
---

<section class="hero section-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-dot"></span>{copy.eyebrow}</p>
    <h1 id="hero-title">{copy.greeting}<br /><span>{copy.name}</span></h1>
    <p class="hero-intro">{copy.intro}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#projects">
        {copy.viewProjects}<span aria-hidden="true">↗</span>
      </a>
      <a class="button button-quiet" href="#contact">{copy.contactMe}</a>
    </div>
    <p class="location"><span aria-hidden="true">⌖</span>{copy.available}</p>
  </div>

  <aside class="profile-card" aria-label={copy.profileLabel}>
    <div class="profile-topline">
      <span>PORTFOLIO / 2026</span>
      <span>01 — 04</span>
    </div>
    <div class="avatar-frame">
      <img
        src={`${base}images/webp/me.webp`}
        alt={copy.portraitAlt}
        width="160"
        height="160"
        fetchpriority="high"
      />
      <span class="avatar-orbit" aria-hidden="true"></span>
    </div>
    <p class="profile-name">Harry Cobos</p>
    <p class="profile-handle">@Harrycr5 <span>·</span> Peru</p>
    <div class="profile-divider"></div>
    <p class="profile-note">{copy.profileNote}</p>
    <div class="social-links">
      <a href="https://github.com/Harrycr5" target="_blank" rel="noreferrer" aria-label="GitHub">
        <img src={`${base}images/webp/github.webp`} alt="" width="24" height="24" />
      </a>
      <a href="https://www.linkedin.com/in/harry-cobos-rivera-93065a314/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
        <img src={`${base}images/webp/linkedin.webp`} alt="" width="24" height="24" />
      </a>
      <a href="https://www.instagram.com/im_harrycr/" target="_blank" rel="noreferrer" aria-label="Instagram">
        <img src={`${base}images/webp/instagram.webp`} alt="" width="24" height="24" />
      </a>
    </div>
    <div class="card-glow" aria-hidden="true"></div>
  </aside>
</section>

<style>
  .hero {
    display: grid;
    min-height: 610px;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    align-items: center;
    gap: clamp(3rem, 9vw, 8rem);
    padding-block: 5rem 6rem;
  }

  .hero-copy {
    max-width: 640px;
  }

  .hero .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .status-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 15px rgba(255, 186, 82, 0.8);
  }

  h1 {
    margin-bottom: 1.1rem;
    font-size: clamp(3.2rem, 7vw, 5.7rem);
    font-weight: 750;
    letter-spacing: -0.075em;
    line-height: 1.02;
  }

  h1 span {
    color: var(--accent);
  }

  .hero-intro {
    max-width: 520px;
    margin-bottom: 2rem;
    color: #c1bbc9;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }

  .button-quiet {
    border-color: var(--line);
    color: #e6e1eb;
  }

  .button-quiet:hover {
    border-color: rgba(255, 186, 82, 0.5);
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.7rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .location span {
    color: var(--accent);
    font-size: 1.1rem;
  }

  .profile-card {
    position: relative;
    overflow: hidden;
    width: min(100%, 350px);
    justify-self: center;
    padding: 1.35rem;
    border: 1px solid rgba(232, 219, 247, 0.15);
    border-radius: 1.2rem;
    background: linear-gradient(145deg, rgba(33, 29, 45, 0.9), rgba(20, 18, 28, 0.9));
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.28);
    text-align: center;
  }

  .profile-topline {
    display: flex;
    justify-content: space-between;
    color: var(--soft);
    font-size: 0.59rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .avatar-frame {
    position: relative;
    display: grid;
    width: 142px;
    height: 142px;
    margin: 2.1rem auto 1.2rem;
    place-items: center;
    border: 1px solid rgba(255, 186, 82, 0.48);
    border-radius: 50%;
    background: linear-gradient(145deg, rgba(255, 186, 82, 0.13), rgba(135, 78, 159, 0.15));
  }

  .avatar-frame img {
    width: 122px;
    height: 122px;
    border: 3px solid rgba(16, 14, 24, 0.85);
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-orbit {
    position: absolute;
    top: 12px;
    right: 2px;
    width: 12px;
    height: 12px;
    border: 2px solid #191622;
    border-radius: 50%;
    background: var(--accent);
  }

  .profile-name {
    margin-bottom: 0.1rem;
    font-size: 1.13rem;
    font-weight: 700;
  }

  .profile-handle {
    margin-bottom: 1.3rem;
    color: var(--muted);
    font-size: 0.79rem;
  }

  .profile-handle span {
    padding-inline: 0.25rem;
    color: var(--accent);
  }

  .profile-divider {
    height: 1px;
    background: var(--line);
  }

  .profile-note {
    margin: 1rem 0 1.1rem;
    color: #d3cedb;
    font-size: 0.84rem;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 0.7rem;
  }

  .social-links a {
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: #e8e2ee;
    font-size: 0.68rem;
    font-weight: 750;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .social-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(255, 186, 82, 0.08);
  }

  .social-links img {
    display: block;
    width: 1.05rem;
    height: 1.05rem;
    object-fit: contain;
  }

  .card-glow {
    position: absolute;
    z-index: -1;
    right: -5rem;
    bottom: -7rem;
    width: 14rem;
    height: 14rem;
    border-radius: 50%;
    background: rgba(138, 64, 160, 0.18);
    filter: blur(42px);
  }

  @media (max-width: 820px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr 0.8fr;
      gap: 2rem;
      padding-block: 5rem;
    }

    .profile-card {
      padding: 1rem;
    }
  }

  @media (max-width: 620px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-block: 4.5rem 4rem;
    }

    h1 {
      font-size: clamp(3.1rem, 16vw, 4.6rem);
    }

    .profile-card {
      width: min(100%, 360px);
    }
  }
</style>
