---
interface Props {
  locale: "es" | "en";
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const english = locale === "en";
const canonicalPath = `${base}${english ? "en/" : ""}`;

const copy = english
  ? {
      title: "Harry Cobos | Software & AI · Data Science & AI",
      description:
        "I'm Harry Cobos, a software engineer focused on AI with experience in data science, backend systems, accounting, hospitality, automated emails and reports, and payment integrations.",
      navAbout: "About",
      navExperience: "Experience",
      navProjects: "Projects",
      navStack: "Stack",
      navContact: "Contact",
      switchLanguage: "Leer en español",
      switchLabel: "ES",
      eyebrow: "AI SOFTWARE ENGINEER · DATA SCIENCE & AI ENGINEER",
      greeting: "Hi, I'm",
      name: "Harry Cobos",
      intro:
        "I build backend services and web applications that solve practical problems, from automated reports to payment integrations.",
      viewProjects: "Explore my work",
      contactMe: "Get in touch",
      available: "Based in Peru · Open to new ideas",
      aboutEyebrow: "A LITTLE ABOUT ME",
      aboutTitle: "Building practical solutions, end to end.",
      aboutText:
        "I'm a software engineer focused on AI, and I also specialize in data science and AI. Since October 2024, I've built backend systems and web applications that turn business needs into reliable software.",
      aboutDetail:
        "My experience includes financial and hospitality systems, payment gateway integrations, automated emails, and reports. I also continue to develop personal projects and reusable tools.",
      experienceEyebrow: "PROFESSIONAL EXPERIENCE",
      experienceTitle: "TLA · Software development",
      experiencePeriod: "October 2024 — Present",
      experienceSummary:
        "Developing backend solutions and business tools, with an emphasis on practical workflows, reliable data, and useful automation.",
      experiencePoints: [
        "Implemented Django-powered Excel reports and automated email workflows to streamline information delivery and follow-up tasks.",
        "Developed a hospitality backend and integrated the Culqi payment gateway for online payments.",
        "Built two backend systems for accounting workflows and financial information management.",
      ],
      projectsEyebrow: "SELECTED WORK",
      projectsTitle: "Projects in progress",
      projectsIntro:
        "A few things I've been building, from a thesis project to tools and experiments.",
      savingsType: "THESIS PROJECT · WEB APP",
      savingsDescription:
        "A personal finance platform for organizing accounts, assets, debts, and payments, with a React frontend and a FastAPI backend.",
      savingsFront: "Frontend",
      savingsBack: "Backend",
      starterType: "DEVELOPER TOOL · BACKEND",
      starterDescription:
        "A reusable FastAPI starting point with user accounts, profiles, permissions, and sessions, backed by PostgreSQL.",
      viewRepo: "View repository",
      fortniteType: "FRONTEND EXPERIMENT",
      fortniteDescription:
        "A frontend practice project exploring Fortnite data and API-powered experiences.",
      stackEyebrow: "TOOLS I USE",
      stackTitle: "My toolkit",
      stackIntro:
        "Frameworks, platforms, and tools I've used to build and support software.",
      contactEyebrow: "LET'S CONNECT",
      contactTitle: "Have an idea in mind?",
      contactText:
        "I'm always glad to connect, talk through a project, or learn about an interesting opportunity.",
      linkedin: "Connect on LinkedIn",
      footer: "Designed and built by Harry Cobos.",
    }
  : {
      title: "Harry Cobos | Ingeniería de Software con IA y Ciencia de Datos e IA",
      description:
        "Soy Harry Cobos, Técnico en Ingeniería de software con IA e Ingeniero en Ciencia de Datos e Inteligencia Artificial, con experiencia en backend, hotelería, contabilidad, correos y reportes automatizados e integraciones de pago.",
      navAbout: "Sobre mí",
      navExperience: "Experiencia",
      navProjects: "Proyectos",
      navStack: "Tecnologías",
      navContact: "Contacto",
      switchLanguage: "Read in English",
      switchLabel: "EN",
      eyebrow: "INGENIERO DE SOFTWARE CON IA · INGENIERO EN CIENCIA DE DATOS E IA",
      greeting: "Hola, soy",
      name: "Harry Cobos",
      intro:
        "Desarrollo soluciones backend y aplicaciones web para resolver necesidades reales, desde reportes automatizados hasta integraciones de pago.",
      viewProjects: "Ver proyectos",
      contactMe: "Hablemos",
      available: "Desde Perú · Abierto a nuevas ideas",
      aboutEyebrow: "UN POCO SOBRE MÍ",
      aboutTitle: "Construyo soluciones prácticas de principio a fin.",
      aboutText:
        "Soy Harry, Técnico en Ingeniería de software con IA e Ingeniero en Ciencia de Datos e Inteligencia Artificial, con experiencia en sistemas backend y aplicaciones web. Desde octubre de 2024, convierto necesidades del día a día en soluciones confiables.",
      aboutDetail:
        "He trabajado en sistemas contables y de hotelería, integraciones de pago, automatización de correos y reportes. También continúo desarrollando proyectos personales y herramientas reutilizables.",
      experienceEyebrow: "EXPERIENCIA PROFESIONAL",
      experienceTitle: "TLA · Desarrollo de software",
      experiencePeriod: "Octubre 2024 — Actualidad",
      experienceSummary:
        "Desarrollo de soluciones backend y herramientas de negocio, con enfoque en procesos prácticos, información confiable y automatización útil.",
      experiencePoints: [
        "Implementé reportes de Excel con Django y correos automatizados para agilizar la distribución de información y las tareas de seguimiento.",
        "Desarrollé el backend de un sistema de hotelería e integré la pasarela de pagos Culqi.",
        "Desarrollé dos sistemas backend orientados a flujos contables y gestión de información financiera.",
      ],
      projectsEyebrow: "TRABAJO DESTACADO",
      projectsTitle: "Proyectos en marcha",
      projectsIntro:
        "Algunas cosas que he creado: desde un proyecto de tesis hasta herramientas y experimentos.",
      savingsType: "PROYECTO DE TESIS · APLICACIÓN WEB",
      savingsDescription:
        "Una plataforma de finanzas personales para organizar cajas, patrimonios, deudas y pagos, con frontend en React y backend en FastAPI.",
      savingsFront: "Frontend",
      savingsBack: "Backend",
      starterType: "HERRAMIENTA · BACKEND",
      starterDescription:
        "Una base reutilizable con FastAPI para gestionar usuarios, perfiles, permisos y sesiones, con PostgreSQL.",
      viewRepo: "Ver repositorio",
      fortniteType: "EXPERIMENTO FRONTEND",
      fortniteDescription:
        "Un proyecto para practicar frontend e integrar datos y funcionalidades de la API de Fortnite.",
      stackEyebrow: "HERRAMIENTAS QUE USO",
      stackTitle: "Mi caja de herramientas",
      stackIntro:
        "Frameworks, plataformas y herramientas que he usado para desarrollar y mantener software.",
      contactEyebrow: "CONECTEMOS",
      contactTitle: "¿Tienes una idea en mente?",
      contactText:
        "Me alegra conectar, conversar sobre un proyecto o conocer oportunidades interesantes.",
      linkedin: "Conectar en LinkedIn",
      footer: "Diseñado y creado por Harry Cobos.",
    };

const projects = [
  {
    number: "01",
    type: copy.savingsType,
    title: "My Savings",
    description: copy.savingsDescription,
    className: "savings",
    tags: ["React", "TypeScript", "FastAPI", "PostgreSQL"],
    links: [
      {
        label: copy.savingsFront,
        href: "https://github.com/Harrycr5/my-savings-frontend",
      },
      {
        label: copy.savingsBack,
        href: "https://github.com/Harrycr5/my-savings-backend",
      },
    ],
  },
  {
    number: "02",
    type: copy.starterType,
    title: "FastAPI Starter Pack",
    description: copy.starterDescription,
    className: "starter",
    tags: ["Python", "FastAPI", "PostgreSQL"],
    links: [
      {
        label: copy.viewRepo,
        href: "https://github.com/Harrycr5/fastapi-starter-pack",
      },
    ],
  },
  {
    number: "03",
    type: copy.fortniteType,
    title: "Fortnite Frontend",
    description: copy.fortniteDescription,
    className: "fortnite",
    tags: ["TypeScript", "Frontend", "API"],
    links: [
      {
        label: copy.viewRepo,
        href: "https://github.com/Harrycr5/fortnite-frontend-website",
      },
    ],
  },
];

const technologies = [
  { name: "Python", icon: "python" },
  { name: "Django", icon: "django" },
  { name: "FastAPI", icon: "fastapi" },
  { name: "Vue.js", icon: "vue" },
  { name: "React", icon: "react" },
  { name: "TypeScript", icon: "typescript" },
  { name: "PostgreSQL", icon: "postgresql" },
  { name: "Docker", icon: "docker" },
  { name: "Postman", icon: "postman" },
  { name: "DBeaver", icon: "dbeaver" },
  { name: "Git", icon: "git" },
  { name: "JavaScript", icon: "javascript" },
  { name: "VS Code", icon: "vscode" },
  { name: "Redis", icon: "redis" },
  { name: "Astro", icon: "astro" },
  { name: "Tailwind CSS", icon: "tailwind" },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content="#100e18" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={new URL(canonicalPath, Astro.site).href} />
    <title>{copy.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{english ? "Skip to content" : "Saltar al contenido"}</a>
    <header class="site-header">
      <nav class="navigation" aria-label={english ? "Main navigation" : "Navegación principal"}>
        <a class="wordmark" href={base} aria-label="Harry Cobos, home">HC<span>.</span></a>
        <div class="nav-links">
          <a href="#about">{copy.navAbout}</a>
          <a href="#experience">{copy.navExperience}</a>
          <a href="#projects">{copy.navProjects}</a>
          <a href="#stack">{copy.navStack}</a>
          <a href="#contact">{copy.navContact}</a>
          <a class="language-link" href={english ? base : `${base}en/`} lang={english ? "es" : "en"} aria-label={copy.switchLanguage}>
            {copy.switchLabel}
          </a>
        </div>
      </nav>
    </header>

    <main id="main">
      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span>{copy.eyebrow}</p>
          <h1 id="hero-title">{copy.greeting}<br /><span>{copy.name}</span></h1>
          <p class="hero-intro">{copy.intro}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#projects">
              {copy.viewProjects}<span aria-hidden="true">↗</span>
            </a>
            <a class="button button-quiet" href="#contact">{copy.contactMe}</a>
          </div>
          <p class="location"><span aria-hidden="true">⌖</span>{copy.available}</p>
        </div>

        <aside class="profile-card" aria-label={english ? "Profile and social links" : "Perfil y redes sociales"}>
          <div class="profile-topline">
            <span class="profile-label">PORTFOLIO / 2026</span>
            <span class="profile-index">01 — 04</span>
          </div>
          <div class="avatar-frame">
            <img
              src={`${base}images/webp/me.webp`}
              alt={english ? "Portrait of Harry Cobos" : "Foto de Harry Cobos"}
              width="160"
              height="160"
              fetchpriority="high"
            />
            <span class="avatar-orbit" aria-hidden="true"></span>
          </div>
          <p class="profile-name">Harry Cobos</p>
          <p class="profile-handle">@Harrycr5 <span>·</span> Peru</p>
          <div class="profile-divider"></div>
          <p class="profile-note">{english ? "Building things with purpose." : "Creando cosas con propósito."}</p>
          <div class="social-links">
            <a href="https://github.com/Harrycr5" target="_blank" rel="noreferrer" aria-label="GitHub">
              <img src={`${base}images/webp/github.webp`} alt="" width="24" height="24" />
            </a>
            <a href="https://www.linkedin.com/in/harry-cobos-rivera-93065a314/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
              <img src={`${base}images/webp/linkedin.webp`} alt="" width="24" height="24" />
            </a>
            <a href="https://www.instagram.com/im_harrycr/" target="_blank" rel="noreferrer" aria-label="Instagram">
              <img src={`${base}images/webp/instagram.webp`} alt="" width="24" height="24" />
            </a>
          </div>
          <div class="card-glow" aria-hidden="true"></div>
        </aside>
      </section>

      <section class="about section-shell section-block" id="about" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="eyebrow">{copy.aboutEyebrow}</p>
          <h2 id="about-title">{copy.aboutTitle}</h2>
        </div>
        <div class="about-copy">
          <p>{copy.aboutText}</p>
          <p>{copy.aboutDetail}</p>
        </div>
      </section>

      <section class="experience section-shell section-block" id="experience" aria-labelledby="experience-title">
        <div class="section-heading experience-heading">
          <p class="eyebrow">{copy.experienceEyebrow}</p>
          <article class="experience-card">
            <div class="experience-meta">
              <h2 id="experience-title">{copy.experienceTitle}</h2>
              <p class="experience-period">{copy.experiencePeriod}</p>
            </div>
            <div class="experience-details">
              <p>{copy.experienceSummary}</p>
              <ul>
                {copy.experiencePoints.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </article>
        </div>
      </section>

      <section class="projects section-shell section-block" id="projects" aria-labelledby="projects-title">
        <div class="section-heading projects-heading">
          <div>
            <p class="eyebrow">{copy.projectsEyebrow}</p>
            <h2 id="projects-title">{copy.projectsTitle}</h2>
          </div>
          <p class="section-intro">{copy.projectsIntro}</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class={`project-card ${project.className}`}>
              <div class="project-visual" aria-hidden="true">
                <span class="project-number">{project.number}</span>
                <div class="visual-window">
                  <span class="window-dots"><i></i><i></i><i></i></span>
                  <span class="visual-line visual-line-long"></span>
                  <span class="visual-line"></span>
                  <span class="visual-block"></span>
                </div>
                <span class="visual-orb"></span>
              </div>
              <div class="project-body">
                <p class="project-type">{project.type}</p>
                <h3>{project.title}</h3>
                <p class="project-description">{project.description}</p>
                <ul class="tag-list" aria-label={english ? "Technologies" : "Tecnologías"}>
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                <div class="project-links">
                  {project.links.map((link) => (
                    <a href={link.href} target="_blank" rel="noreferrer">
                      {link.label}<span aria-hidden="true"> ↗</span>
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="stack section-shell section-block" id="stack" aria-labelledby="stack-title">
        <div class="section-heading">
          <p class="eyebrow">{copy.stackEyebrow}</p>
          <h2 id="stack-title">{copy.stackTitle}</h2>
          <p class="section-intro">{copy.stackIntro}</p>
        </div>
        <ul class="technology-list">
          {technologies.map((technology) => (
            <li>
              <img
                src={`${base}images/webp/${technology.icon}.webp`}
                alt=""
                width="40"
                height="40"
                loading="lazy"
              />
              <span>{technology.name}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="contact section-shell section-block" id="contact" aria-labelledby="contact-title">
        <div class="contact-panel">
          <div>
            <p class="eyebrow">{copy.contactEyebrow}</p>
            <h2 id="contact-title">{copy.contactTitle}</h2>
            <p>{copy.contactText}</p>
          </div>
          <a class="button button-primary" href="https://www.linkedin.com/in/harry-cobos-rivera-93065a314/" target="_blank" rel="noreferrer">
            {copy.linkedin}<span aria-hidden="true">↗</span>
          </a>
          <span class="contact-decoration" aria-hidden="true">HC</span>
        </div>
      </section>
    </main>

    <footer class="site-footer section-shell">
      <a class="wordmark footer-mark" href={base}>HC<span>.</span></a>
      <p>{copy.footer}</p>
      <a href="#main">{english ? "Back to top ↑" : "Volver arriba ↑"}</a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
  }

  :global(body) {
    --background: #100e18;
    --panel: rgba(25, 22, 35, 0.82);
    --panel-light: #191622;
    --text: #f3f0f7;
    --muted: #a7a1b3;
    --soft: #777183;
    --accent: #ffba52;
    --accent-bright: #ffd18a;
    --line: rgba(238, 230, 249, 0.12);
    margin: 0;
    color: var(--text);
    background:
      radial-gradient(ellipse at 82% 16%, rgba(114, 55, 134, 0.2), transparent 34rem),
      radial-gradient(ellipse at 12% 36%, rgba(93, 49, 112, 0.14), transparent 32rem),
      var(--background);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }

  .skip-link {
    position: absolute;
    z-index: 20;
    top: 0.7rem;
    left: 0.7rem;
    padding: 0.6rem 0.9rem;
    transform: translateY(-160%);
    color: var(--background);
    background: var(--accent);
    border-radius: 0.5rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    z-index: 10;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: rgba(16, 14, 24, 0.82);
    backdrop-filter: blur(18px);
  }

  .navigation,
  .section-shell {
    width: min(1120px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .navigation {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    color: var(--text);
    font-size: 1.45rem;
    font-weight: 850;
    letter-spacing: -0.1em;
  }

  .wordmark span {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.2rem);
    color: #d0cbd8;
    font-size: 0.9rem;
  }

  .nav-links a:not(.language-link) {
    transition: color 160ms ease;
  }

  .nav-links a:hover,
  .site-footer a:hover {
    color: var(--accent);
  }

  .language-link {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid rgba(255, 186, 82, 0.44);
    border-radius: 50%;
    color: var(--accent-bright);
    font-size: 0.74rem;
    font-weight: 750;
  }

  .hero {
    display: grid;
    min-height: 610px;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    align-items: center;
    gap: clamp(3rem, 9vw, 8rem);
    padding-block: 5rem 6rem;
  }

  .hero-copy {
    max-width: 640px;
  }

  .eyebrow {
    margin: 0 0 1.1rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    line-height: 1.4;
  }

  .hero .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .status-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 15px rgba(255, 186, 82, 0.8);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1.1rem;
    font-size: clamp(3.2rem, 7vw, 5.7rem);
    font-weight: 750;
    letter-spacing: -0.075em;
    line-height: 1.02;
  }

  h1 span {
    color: var(--accent);
  }

  .hero-intro {
    max-width: 520px;
    margin-bottom: 2rem;
    color: #c1bbc9;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid transparent;
    border-radius: 0.65rem;
    font-size: 0.88rem;
    font-weight: 700;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    color: #17121c;
    background: var(--accent);
  }

  .button-primary:hover {
    background: var(--accent-bright);
  }

  .button-quiet {
    border-color: var(--line);
    color: #e6e1eb;
  }

  .button-quiet:hover {
    border-color: rgba(255, 186, 82, 0.5);
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.7rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .location span {
    color: var(--accent);
    font-size: 1.1rem;
  }

  .profile-card {
    position: relative;
    overflow: hidden;
    width: min(100%, 350px);
    justify-self: center;
    padding: 1.35rem;
    border: 1px solid rgba(232, 219, 247, 0.15);
    border-radius: 1.2rem;
    background: linear-gradient(145deg, rgba(33, 29, 45, 0.9), rgba(20, 18, 28, 0.9));
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.28);
    text-align: center;
  }

  .profile-topline {
    display: flex;
    justify-content: space-between;
    color: var(--soft);
    font-size: 0.59rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .avatar-frame {
    position: relative;
    display: grid;
    width: 142px;
    height: 142px;
    margin: 2.1rem auto 1.2rem;
    place-items: center;
    border: 1px solid rgba(255, 186, 82, 0.48);
    border-radius: 50%;
    background: linear-gradient(145deg, rgba(255, 186, 82, 0.13), rgba(135, 78, 159, 0.15));
  }

  .avatar-frame img {
    width: 122px;
    height: 122px;
    border: 3px solid rgba(16, 14, 24, 0.85);
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-orbit {
