---
import en from "../i18n/en";
import es from "../i18n/es";
import "../styles/portfolio.css";
import SiteHeader from "./portfolio/SiteHeader.astro";
import Hero from "./portfolio/Hero.astro";
import About from "./portfolio/About.astro";
import Experience from "./portfolio/Experience.astro";
import Projects from "./portfolio/Projects.astro";
import TechnologyStack from "./portfolio/TechnologyStack.astro";
import Contact from "./portfolio/Contact.astro";
import SiteFooter from "./portfolio/SiteFooter.astro";

interface Props {
  locale: "es" | "en";
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const english = locale === "en";
const canonicalPath = `${base}${english ? "en/" : ""}`;
const copy = english ? en : es;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content="#100e18" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={new URL(canonicalPath, Astro.site).href} />
    <title>{copy.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skipLink}</a>
    <SiteHeader {copy} {base} {english} />

    <main id="main">
      <Hero {copy} {base} />
      <About {copy} />
      <Experience {copy} />
      <Projects {copy} />
      <TechnologyStack {copy} {base} />
      <Contact {copy} />
    </main>

    <SiteFooter {copy} {base} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    z-index: 20;
    top: 0.7rem;
    left: 0.7rem;
    padding: 0.6rem 0.9rem;
    transform: translateY(-160%);
    color: var(--background);
    background: var(--accent);
    border-radius: 0.5rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
